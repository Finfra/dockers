# vllm_qwen38 환경값 (cp .env.sample .env 후 수정)

# 이미지 — TurboQuant KV cache 는 vLLM v0.30.0 upstream 내장
#   v0.30.0       : CUDA 13.0 빌드 (드라이버 580+ 필요)
#   v0.30.0-cu129 : CUDA 12.9 빌드 (드라이버 575+ 권장) ← 기본값
VLLM_IMAGE_TAG=v0.30.0-cu129

# 모델 — 3bit GGUF(unsloth UD-IQ3_S, 12GB)로 16GB GPU 단독 적재 (vllm-gguf-plugin)
#   AWQ INT4 + CPU offload 구성(0.65 tok/s)은 .env.awq.sample 참조
VLLM_MODEL=unsloth/Qwen3.8-27B-GGUF:UD-IQ3_S
SERVED_MODEL_NAME=qwen3.8-27b

# 포트·컨테이너
VLLM_PORT=8000
VLLM_CONTAINER_NAME=vllm-qwen38

# TurboQuant KV cache 프리셋 (압축률 낮음 → 높음)
#   turboquant_k8v4      K=FP8, V=4bit   (품질 우선)
#   turboquant_4bit_nc   K=4bit, V=4bit  ← 기본값
#   turboquant_k3v4_nc   K=3bit, V=4bit
#   turboquant_3bit_nc   K=3bit, V=3bit  (최대 압축)
KV_CACHE_DTYPE=turboquant_4bit_nc

# 메모리 튜닝 (16GB GPU + 31GB RAM 기준)
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=2
# prefill 1회 처리 토큰 수 — 클수록 빠르나 logits(vocab 248K) 버퍼가 커짐. 16GB 는 512 권장
MAX_NUM_BATCHED_TOKENS=512
GPU_MEMORY_UTILIZATION=0.95
# 가중치가 VRAM 을 넘으면 초과분을 CPU RAM 으로 (0 = 미사용, 늘릴수록 느려짐)
CPU_OFFLOAD_GB=0

# 추가 vllm serve 인자 — GGUF 는 tokenizer·config 를 원본 repo 에서 (텍스트 전용)
VLLM_EXTRA_ARGS="--tokenizer Qwen/Qwen3.8-27B --hf-config-path Qwen/Qwen3.8-27B --language-model-only"

# 공유 볼륨 — 호스트 df 폴더 → 컨테이너 /df
DF_DIR=~/df
# HF 모델 캐시 (호스트와 공유하여 재다운로드 방지)
HF_CACHE_DIR=~/.cache/huggingface
# vLLM torch.compile 캐시
VLLM_CACHE_DIR=~/.cache/vllm
# gated/비공개 모델용 (공개 모델이면 비워둠)
HF_TOKEN=

TZ=Asia/Seoul
