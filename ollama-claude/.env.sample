# ollama-claude .env.sample — 실제값 채운 .env 는 커밋 금지.
# 사용: cp .env.sample .env 후 값 수정, 그다음 ./start.sh

# === 모델 설정 ===
# 사용할 Ollama 모델 태그 (예: qwen3-coder:30b, gemma3, llama3.1:8b)
OLLAMA_MODEL=qwen3-coder:30b

# 호스트 ~/.ollama 와 모델 공유 여부
# 공유: OLLAMA_MOUNT=~/.ollama
# 격리(컨테이너 named volume): OLLAMA_MOUNT=ollama-models
OLLAMA_MOUNT=ollama-models

# 호스트 코드 폴더 마운트 (선택)
# 사용 시 docker-compose.code.yml override 적용
# MOUNT_CODE_DIR=~/code
MOUNT_CODE_DIR=

# === 컨테이너·네트워크·포트 (다중 인스턴스 동시 실행 시 충돌 회피) ===
COMPOSE_PROJECT_NAME=ollama_claude
OLLAMA_CONTAINER_NAME=ollama-claude
CLAUDE_CONTAINER_NAME=claude-code
OLLAMA_NETWORK_NAME=claude-ollama
OLLAMA_PORT=11436

# === 사용자 UID/GID (호스트 파일 권한 일치, 코드 마운트 시 중요) ===
# Linux 호스트: `id -u`, `id -g` 결과로 맞출 것 권장
# macOS Docker Desktop: 1000 그대로 두어도 자동 위임됨
USER_UID=1000
USER_GID=1000

# === Ollama 성능·VRAM 튜닝 ===
# Flash Attention (1=on, 0=off — OOM 시 폴백)
OLLAMA_FLASH_ATTENTION=1
# KV cache 양자화: f16(정확도 우선) / q8_0(균형, 권장) / q4_0(VRAM 절감 최대)
OLLAMA_KV_CACHE_TYPE=q8_0
# GPU 레이어 수 (999 = 전 레이어 GPU 로드)
OLLAMA_NUM_GPU=999
# 컨텍스트 길이
OLLAMA_CONTEXT_LENGTH=100000

# === 타임존 (컨테이너 내 git commit·로그 시각) ===
TZ=Asia/Seoul
